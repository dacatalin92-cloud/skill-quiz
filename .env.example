# Copiaza acest fisier in ".env" si completeaza valorile tale reale.
# NU urca niciodata fisierul ".env" (cu cheile reale) intr-un loc public (git, email etc).

# IMPORTANT: platforma foloseste PayU Romania (contul de "marketplace"/split
# de plati, prin shoppingCarts in API-ul PayU) pentru a imparti automat banii
# intre platforma ta si fiecare vanzator. Acest tip de cont NU e acelasi lucru
# cu un cont PayU obisnuit de comerciant - vezi README.md, sectiunea PayU,
# pentru ce trebuie sa ceri exact contului tau PayU inainte de lansare.

# ID-ul punctului de vanzare (POS) PayU - din contul tau de comerciant PayU.
# Valorile de mai jos sunt cele PUBLICE de test/sandbox din documentatia PayU
# (developers.payu.com/europe) - merg doar pe mediul de sandbox, NU pentru
# bani reali. Inlocuieste-le cu ale tale cand primesti acces la contul real.
PAYU_POS_ID=491057

# Client ID / Client Secret pentru autentificarea OAuth2 (client_credentials)
# - din acelasi cont de comerciant PayU.
PAYU_CLIENT_ID=491057
PAYU_CLIENT_SECRET=d807005b11ca38eea8a3c1a794635b4f

# "Second key" (cheia MD5) folosita pentru verificarea semnaturii notificarilor
# trimise de PayU pe /payu/notificare (header OpenPayu-Signature).
PAYU_SECOND_KEY=bac30a8686d9a31cbc9f3a25553e2f62

# ID-ul de partener de marketplace, folosit la generarea link-ului de
# inscriere (boarding) a vanzatorilor. Daca nu ai unul distinct, lasa gol -
# codul foloseste PAYU_POS_ID ca fallback.
PAYU_MARKETPLACE_PARTNER_ID=

# true = mediul de sandbox PayU (secure.snd.payu.com), fara bani reali.
# false = productie (secure.payu.com), cu bani reali.
PAYU_SANDBOX=true

# Adresa publica unde va rula site-ul (fara slash la final). PayU trimite
# notificari de plata catre "${BASE_URL}/payu/notificare" - trebuie sa fie
# accesibila public din internet (nu functioneaza cu localhost simplu; in
# dezvoltare locala foloseste un tunel de tip ngrok/cloudflared).
# Local: http://localhost:3000
# Productie: https://magazinul-tau.ro
BASE_URL=http://localhost:3000

# Portul pe care porneste serverul local
PORT=3000

# Numarul de incercari permise la intrebare, dupa plata
MAX_ATTEMPTS=3

# Numarul maxim de descarcari permise per link
MAX_DOWNLOADS=10

# Numarul maxim de bucati pe care un client le poate cumpara intr-o singura comanda
MAX_QUANTITY_PER_ORDER=20

# Comisionul platformei, in procente, retinut automat din fiecare vanzare
# (restul se duce automat catre vanzator, prin split-ul de plata PayU)
PLATFORM_FEE_PERCENT=15

# Secret folosit pentru a semna cookie-urile de autentificare (vanzatori si admin).
# Genereaza unul lung si aleatoriu pentru productie (ex: openssl rand -hex 32)
# si NU il schimba dupa lansare (altfel toata lumea e delogata).
SESSION_SECRET=schimba-acest-secret-cu-unul-lung-si-aleatoriu

# Parola ta, de administrator, pentru /admin/login.html - acces complet la
# TOATE comenzile de la TOTI vanzatorii (nume, telefon, numere de bilet).
# Alege una puternica si nu o distribui.
ADMIN_PASSWORD=schimba-aceasta-parola

# Optional - trimitere de email-uri automate (bun venit vanzator nou,
# confirmare comanda catre client) prin Resend (resend.com, cont gratuit).
# Daca lipseste RESEND_API_KEY, platforma functioneaza normal, doar fara
# email-uri (asa cum a fost inainte).
RESEND_API_KEY=
# Adresa "from". Fara domeniu propriu verificat pe Resend, lasa valoarea
# implicita (onboarding@resend.dev) - poti trimite doar catre adresa cu care
# ti-ai facut contul pe Resend. Cu un domeniu verificat, foloseste o adresa
# de pe acel domeniu (ex: comenzi@magazinul-tau.ro).
RESEND_FROM=onboarding@resend.dev
